# JARGON_BASE_URL：Jargon Vault 服務位址（同一台機器跑 main.py 的話用預設值即可）
JARGON_BASE_URL=http://127.0.0.1:8787

# 登入方式一：帳號密碼（跟 ALLOWED_EMAILS 白名單裡註冊過的帳號一致）
JARGON_EMAIL=you@example.com
JARGON_PASSWORD=your-password

# 登入方式二：直接提供瀏覽器登入後拿到的 gv_session cookie 值，設了這個就不需要帳密
# （瀏覽器開發工具 → Application/儲存空間 → Cookies → 找 gv_session 複製 value）
# JARGON_SESSION_COOKIE=
